# ArchBot backend environment variables
# Copy to .env (never commit .env) and fill in values.
#
# -----------------------------------------------------------------------
# LLM Provider selection
# -----------------------------------------------------------------------
# Which LLM backend to use for generation.
# Options: bedrock (default) | openrouter | ollama
LLM_PROVIDER=openrouter

# -----------------------------------------------------------------------
# OpenRouter (LLM_PROVIDER=openrouter)
# -----------------------------------------------------------------------
# Get a free API key at https://openrouter.ai/
# Free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use. Default is a free model; override for a paid/better model.
# Examples:
#   meta-llama/llama-3.1-8b-instruct:free   (free, default)
#   meta-llama/llama-3.3-70b-instruct:free  (free, better quality)
#   anthropic/claude-3.5-sonnet             (paid)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional: override the OpenRouter base URL (e.g. for a proxy)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------
# Ollama (LLM_PROVIDER=ollama)
# -----------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------
# Amazon Bedrock (LLM_PROVIDER=bedrock, default)
# -----------------------------------------------------------------------
# AWS credentials are resolved by boto3 via the standard chain:
#   ~/.aws/credentials, IAM role, env vars (AWS_ACCESS_KEY_ID etc.)
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_DEFAULT_REGION=us-east-1

# -----------------------------------------------------------------------
# RAG retrieval store (all providers)
# -----------------------------------------------------------------------
# Option A: Amazon Bedrock Knowledge Base
# KNOWLEDGE_BASE_ID=<from CDK outputs>
# KB_DATA_SOURCE_ID=<from CDK outputs>

# Option B: OpenSearch Serverless
# OPENSEARCH_ENDPOINT=https://<collection-id>.us-east-1.aoss.amazonaws.com
# VECTOR_INDEX_NAME=archbot-wa-index

# Option C: Local Chroma (no AWS required)
# CHROMA_PATH=./chroma_db

# -----------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------
# RAG_TOP_K=20
