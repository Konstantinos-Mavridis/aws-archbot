# ArchBot Backend — local dev image
# Installs the [local] extras: chromadb, sentence-transformers, httpx
# Does NOT include AWS CDK / Lambda tooling

FROM python:3.12-slim

WORKDIR /app

# System deps for sentence-transformers native build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[local]"

# App source is volume-mounted in docker-compose for hot reload;
# copy here so the image also works standalone.
COPY app ./app
COPY scripts ./scripts
