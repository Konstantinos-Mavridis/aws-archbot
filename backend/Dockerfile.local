# ArchBot Backend — local dev image
# Installs the [local] extras: chromadb, sentence-transformers, httpx

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies from pyproject.toml (regular install, not editable)
# Source code is volume-mounted at runtime for hot reload
COPY pyproject.toml ./
# Stub out the app package so pip can resolve it without the full source tree
RUN mkdir -p app && touch app/__init__.py
RUN pip install --no-cache-dir ".[local]"

# Copy source (used when running without a volume mount)
COPY app ./app
COPY scripts ./scripts
